{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "0.5.4",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "author": "hamb1y",
  "homepage_url": "https://github.com/hamb1y/foxhand",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "webmcp-controller@hamb1y.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent",
          "websiteActivity",
          "bookmarksInfo"
        ],
        "optional": [
          "technicalAndInteraction"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "nativeMessaging",
    "bookmarks",
    "history",
    "downloads",
    "sessions",
    "cookies",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/cursor.js",
        "content/ax.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "commands": {
    "toggle-pause": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period"
      },
      "description": "__MSG_cmdPause__"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
