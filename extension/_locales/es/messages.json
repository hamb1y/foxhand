  "ob3": {
    "message": "Pruébalo"
  },
  "ob3Intro": {
    "message": "Pídele a tu IA algo como:"
  },
  "obTry1": {
    "message": "Revisa mis pestañas abiertas y agrúpalas por tema."
  },
  "obTry2": {
    "message": "Abre github.com/hamb1y/foxhand y dime qué cambió en la última versión."
  },
  "obTry3": {
    "message": "Busca en mi historial el último artículo que leí sobre Firefox y resúmelo."
  },
  "obTips": {
    "message": "Es bueno saber"
