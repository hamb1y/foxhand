  "obTitle": {
    "message": "Te damos la bienvenida a Foxhand"
  },
  "obIntro": {
    "message": "Foxhand permite que tu agente de IA use este Firefox, con tus pestañas y tus sesiones iniciadas, a través de MCP. Todo se queda en tu computadora. La configuración toma alrededor de un minuto."
  },
  "obRenamed": {
    "message": "WebMCP Controller ahora se llama Foxhand. Es el mismo complemento, con la misma configuración. Si el paso 1 lo pide, ejecuta el comando de instalación una vez más para actualizar la app auxiliar."
  },
  "obChecking": {
    "message": "Comprobando…"
  },
  "ob1": {
    "message": "Instala la app auxiliar"
  },
  "ob1Why": {
    "message": "Los complementos de Firefox no pueden abrir puertos de red, así que una pequeña app auxiliar sirve MCP para Foxhand. Solo escucha en esta computadora."
  },
  "ob1Done": {
    "message": "La app auxiliar v$P1$ está en ejecución.",
    "placeholders": {
      "p1": {
        "content": "$1"
      }
    }
  },
  "ob2": {
    "message": "Conecta tu IA"
  },
  "ob2Pick": {
    "message": "¿Qué IA usas?"
  },
  "ob2Waiting": {
    "message": "Esperando el primer comando de tu IA…"
  },
  "ob2Done": {
    "message": "Conectada. Tu IA acaba de hacer: $P1$",
