  "obTitle": {
    "message": "Bienvenue dans Foxhand"
  },
  "obIntro": {
    "message": "Foxhand permet à votre agent IA d’utiliser ce Firefox, avec vos onglets et vos sessions ouvertes, via MCP. Tout reste sur votre ordinateur. L’installation prend environ une minute."
  },
  "obRenamed": {
    "message": "WebMCP Controller s’appelle désormais Foxhand. Même extension, mêmes paramètres. Si l’étape 1 le demande, exécutez la commande d’installation une fois de plus pour mettre à jour l’assistant."
  },
  "obChecking": {
    "message": "Vérification…"
  },
  "ob1": {
    "message": "Installer l’application d’assistance"
  },
  "ob1Why": {
    "message": "Les extensions Firefox ne peuvent pas ouvrir de ports réseau : une petite application d’assistance sert donc MCP pour Foxhand. Elle n’écoute que sur cet ordinateur."
  },
  "ob1Done": {
    "message": "L’assistant v$P1$ fonctionne.",
    "placeholders": {
      "p1": {
        "content": "$1"
      }
    }
  },
  "ob2": {
    "message": "Connecter votre IA"
  },
  "ob2Pick": {
    "message": "Quelle IA utilisez-vous ?"
  },
  "ob2Waiting": {
    "message": "En attente de la première commande de votre IA…"
  },
  "ob2Done": {
    "message": "Connectée. Votre IA vient de faire : $P1$",
    "placeholders": {
      "p1": {
        "content": "$1"
      }
    }
  },
  "obWslNote": {
    "message": "Votre IA fonctionne dans WSL ? Configurez-la dans Paramètres → Connecter votre IA."
  },
  "ob3": {
    "message": "Essayez"
  },
  "ob3Intro": {
    "message": "Demandez à votre IA quelque chose comme :"
  },
  "obTry1": {
    "message": "Regarde mes onglets ouverts et regroupe-les par sujet."
  },
  "obTry2": {
    "message": "Ouvre github.com/hamb1y/foxhand et dis-moi ce qui a changé dans la dernière version."
  },
  "obTry3": {
    "message": "Cherche dans mon historique le dernier article que j’ai lu sur Firefox et résume-le."
  },
  "obTips": {
    "message": "Bon à savoir"
  },
  "obTipCursor": {
    "message": "Un curseur montre où l’IA agit, avec une bulle orange qui indique ce qu’elle fait."
  },
  "obTipPause": {
    "message": "Appuyez sur $P1$ (ou sur « Mettre l’IA en pause » dans le menu de la barre d’outils) pour arrêter toutes les commandes d’un coup.",
    "placeholders": {
      "p1": {
        "content": "$1"
      }
    }
  },
  "obTipSafety": {
    "message": "L’IA doit confirmer avant de fermer des onglets ou de supprimer des marque-pages, et elle ne peut pas lire vos mots de passe enregistrés."
