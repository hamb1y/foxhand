  "obTitle": {
    "message": "Welcome to Foxhand"
  },
  "obIntro": {
    "message": "Foxhand lets your AI agent use this Firefox, with your tabs and your logins, through MCP. Everything stays on your computer. Setup takes about a minute."
  },
  "obRenamed": {
    "message": "WebMCP Controller is now called Foxhand. Same add-on, same settings. If step 1 asks, run the install command once more to update the helper."
  },
  "obChecking": {
    "message": "Checking…"
  },
  "ob1": {
    "message": "Install the helper app"
  },
  "ob1Why": {
    "message": "Firefox add-ons can’t open network ports, so a small helper app serves MCP for Foxhand. It only listens on this computer."
  },
  "ob1Done": {
    "message": "Helper v$P1$ is running.",
    "placeholders": {
      "p1": {
        "content": "$1"
      }
    }
  },
  "ob2": {
    "message": "Connect your AI"
  },
  "ob2Pick": {
    "message": "Which AI do you use?"
  },
  "ob2Waiting": {
    "message": "Waiting for your AI’s first command…"
  },
  "ob2Done": {
    "message": "Connected. Your AI just did: $P1$",
    "placeholders": {
      "p1": {
        "content": "$1"
      }
    }
  },
  "obWslNote": {
    "message": "AI running inside WSL? Set that up in Settings → Connect your AI."
  },
  "ob3": {
    "message": "Try it"
  },
  "ob3Intro": {
    "message": "Ask your AI something like:"
  },
  "obTry1": {
    "message": "Look at my open tabs and group them by topic."
  },
  "obTry2": {
    "message": "Open github.com/hamb1y/foxhand and tell me what changed in the latest release."
  },
  "obTry3": {
    "message": "Search my history for the last article I read about Firefox and summarize it."
  },
  "obTips": {
    "message": "Good to know"
  },
  "obTipCursor": {
    "message": "A cursor shows where the AI is acting, with an orange bubble saying what it’s doing."
  },
  "obTipPause": {
    "message": "Press $P1$ (or Pause AI in the toolbar popup) to stop every command at once.",
    "placeholders": {
      "p1": {
        "content": "$1"
      }
    }
  },
  "obTipSafety": {
    "message": "The AI has to confirm before closing tabs or deleting bookmarks, and it can’t read your saved passwords."
  },
  "obSettings": {
    "message": "All settings"
  },
  "obDocs": {
    "message": "Documentation"
