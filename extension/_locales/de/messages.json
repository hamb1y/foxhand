  "obTitle": {
    "message": "Willkommen bei Foxhand"
  },
  "obIntro": {
    "message": "Mit Foxhand kann Ihr KI-Agent dieses Firefox nutzen, mit Ihren Tabs und Anmeldungen, über MCP. Alles bleibt auf Ihrem Computer. Die Einrichtung dauert etwa eine Minute."
  },
  "obRenamed": {
    "message": "WebMCP Controller heißt jetzt Foxhand. Gleiches Add-on, gleiche Einstellungen. Falls Schritt 1 danach fragt, führen Sie den Installationsbefehl noch einmal aus, um die Hilfs-App zu aktualisieren."
  },
  "obChecking": {
    "message": "Wird geprüft…"
  },
  "ob1": {
    "message": "Hilfs-App installieren"
  },
  "ob1Why": {
    "message": "Firefox-Add-ons können keine Netzwerk-Ports öffnen, deshalb stellt eine kleine Hilfs-App MCP für Foxhand bereit. Sie lauscht nur auf diesem Computer."
  },
  "ob1Done": {
    "message": "Hilfs-App v$P1$ läuft.",
    "placeholders": {
      "p1": {
        "content": "$1"
      }
    }
  },
  "ob2": {
    "message": "Ihre KI verbinden"
  },
  "ob2Pick": {
    "message": "Welche KI nutzen Sie?"
  },
  "ob2Waiting": {
    "message": "Warte auf den ersten Befehl Ihrer KI…"
  },
  "ob2Done": {
    "message": "Verbunden. Ihre KI hat gerade: $P1$",
    "placeholders": {
      "p1": {
        "content": "$1"
      }
    }
  },
  "obWslNote": {
    "message": "Läuft Ihre KI in WSL? Richten Sie das unter Einstellungen → Ihre KI verbinden ein."
  },
  "ob3": {
    "message": "Ausprobieren"
  },
  "ob3Intro": {
    "message": "Bitten Sie Ihre KI zum Beispiel:"
  },
  "obTry1": {
    "message": "Sieh dir meine offenen Tabs an und gruppiere sie nach Thema."
  },
  "obTry2": {
    "message": "Öffne github.com/hamb1y/foxhand und sag mir, was sich in der neuesten Version geändert hat."
  },
  "obTry3": {
    "message": "Such in meiner Chronik den letzten Artikel, den ich über Firefox gelesen habe, und fasse ihn zusammen."
  },
  "obTips": {
    "message": "Gut zu wissen"
  },
  "obTipCursor": {
    "message": "Ein Cursor zeigt, wo die KI gerade handelt, mit einer orangen Sprechblase, die sagt, was sie tut."
  },
  "obTipPause": {
    "message": "Drücken Sie $P1$ (oder „KI pausieren“ im Symbolleisten-Menü), um alle Befehle auf einmal anzuhalten.",
    "placeholders": {
      "p1": {
        "content": "$1"
      }
    }
  },
  "obTipSafety": {
    "message": "Die KI muss bestätigen, bevor sie Tabs schließt oder Lesezeichen löscht, und sie kann Ihre gespeicherten Passwörter nicht lesen."
  },
